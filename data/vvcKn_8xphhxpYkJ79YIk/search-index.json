]},"20251223-which-tool-to-use-for-adr-decisions":{"position":[[24,9]]}}}],["static",{"_index":58,"title":{},"verbatim":{"20251223-use-log4brains-to-manage-the-adrs":{"position":[[277,6],[548,6]]}}}],["statu",{"_index":143,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[1626,7]]}}}],["status=\"accept",{"_index":151,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[1772,17]]}}}],["structur",{"_index":77,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[116,9],[774,9],[1180,9]]}}}],["style",{"_index":116,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[1162,6]]}}}],["supabas",{"_index":17,"title":{},"verbatim":{"20251202-which-database-to-use":{"position":[[218,8],[275,9]]}}}],["support",{"_index":10,"title":{},"verbatim":{"20251202-which-database-to-use":{"position":[[135,7]]},"20251223-which-tool-to-use-for-adr-decisions":{"position":[[420,8]]}}}],["sustain",{"_index":89,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[496,12]]}}}],["tag",{"_index":128,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[1398,5],[1675,6]]}}}],["talk",{"_index":34,"title":{},"verbatim":{"20251202-which-database-to-use":{"position":[[493,4]]}}}],["templat",{"_index":93,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[636,9],[1481,9]]}}}],["template](http://thinkrelevance.com/blog/2011/11/15/docu",{"_index":85,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[364,63]]}}}],["term",{"_index":88,"title":{},"verbatim":{"20251223-use-markdown-architectural-decision-records":{"position":[[483,4]]}}}],["think",{"_index":43,"title":{},"verbatim":{"20251202-which-database-to-use":{"position":[[644,5]]}}}],["title=\"us",{"_index":152,"title":{},"verbatim":{"202512