1,9]]}}}],["known",{"_index":29,"t":{"49":{"position":[[36,5]]}}}],["lot",{"_index":35,"t":{"51":{"position":[[49,3]]}}}],["made",{"_index":9,"t":{"37":{"position":[[20,4]]},"39":{"position":[[17,4]]}}}],["mongodb",{"_index":31,"t":{"49":{"position":[[56,7]]}}}],["peopl",{"_index":34,"t":{"51":{"position":[[36,6]]}}}],["react",{"_index":12,"t":{"39":{"position":[[27,6]]}}}],["render",{"_index":17,"t":{"41":{"position":[[29,7]]}}}],["return",{"_index":23,"t":{"45":{"position":[[0,6]]}}}],["statu",{"_index":6,"t":{"13":{"position":[[2,7]]},"27":{"position":[[2,7]]}}}],["thing",{"_index":37,"t":{"51":{"position":[[62,6]]}}}],["time",{"_index":38,"t":{"51":{"position":[[77,5]]}}}],["tragedi",{"_index":32,"t":{"49":{"position":[[64,9]]}}}],["typescript",{"_index":14,"t":{"39":{"position":[[43,11]]}}}],["us",{"_index":19,"t":{"43":{"position":[[7,4]]}}}],["valid",{"_index":20,"t":{"43":{"position":[[16,10]]}}}],["vite",{"_index":13,"t":{"39":{"position":[[34,4]]}}}],["welcom",{"_index":0,"t":{"1":{"position":[[0,7]]},"7":{"position":[[0,7]]}}}],["zod",{"_index":18,"t":{"43":{"position":[[0,3]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":2,"t":"Welcome 👋 to the architecture knowledge base of cqrs. You will find here all the Architecture Decision Records (ADR) of the project.","s":"Architecture knowledge base","u":"/cqrs/docs/adr/","h":"","p":1},{"i":4,"t":"An Architectural Decision (AD) is a software design choice that addresses a functional or non-functional requirement that is architecturally significant. An Architectural Decision Record (ADR) captures a single AD, such as often done when writing personal notes or meeting minutes; the collection of ADRs created and maintained in a project constitutes its decision log. An ADR is immutable: only its status can change (i.e., become deprecated or superseded). That way, you can become familiar with the whole project history just by reading its decision log in chronological order. Moreover, maintaining this documentation aims at: 🚀 Improving and speeding up the onboarding of a new team member 🔭 Avoiding blind acceptance/reversal of a past decision (cf Michael Nygard's famous article on ADRs) 🤝 Formalizing the decision process of the team","s":"Definition and purpose","u":"/cqrs/docs/adr/","h":"#definition-and-purpose","p":1},{"i":6,"t":"This website is automatically updated after a change on the main branch of the project's Git repository. In fact, the developers manage this documentation directly with markdown files located next to their code, so it is more convenient for them to keep it up-to-date. You can browse the ADRs by using the left menu or the search bar.","s":"Usage","u":"/cqrs/docs/adr/","h":"#usage","p":1},{"i":8,"t":"Welcome 👋 to the architecture knowledge base of cqrs. You will find here all the Architecture Decision Records (ADR) of the project.","s":"Architecture knowledge base","u":"/cqrs/docs/adr/","h":"","p":7},{"i":10,"t":"An Architectural Decision (AD) is a software design choice that addresses a functional or non-functional requirement that is architecturally significant. An Architectural Decision Record (ADR) captures a single AD, such as often done when writing personal notes or meeting minutes; the collection of ADRs created and maintained in a project constitutes its decision log. An ADR is immutable: only its status can change (i.e., become deprecated or superseded). That way, you can become familiar with the whole project history just by reading its decision log in chronological order. Moreover, maintaining this documentation aims at: 🚀 Improving and speeding up the onboarding of a new team member 🔭 Avoiding blind acceptance/reversal of a past decision (cf Michael Nygard's famous article on ADRs) 🤝 Formalizing the decision process of the team","s":"Definition and purpose","u":"/cqrs/docs/adr/","h":"#definition-and-purpose","p":7},{"i":12,"t":"This website is automatically updated after a change on the main branch of the project's Git repository. In fact, the developers manage this documentation directly with markdown files located next to their code, so it is more convenient for them to keep it up-to-date. You can browse the ADRs by using the left menu or the search bar.","s":"Usage","u":"/cqrs/docs/adr/","h":"#usage","p":7},{"i":14,"t":"Status: accepted Date: 2025-12-02 Tags: database,mongodb,supabase,postgres","s":"Which database to use?","u":"/cqrs/docs/adr/which-database-to-use","h":"","p":13},{"i":16,"t":"Which database should I use for this project?","s":"Context and Problem Statement","u":"/cqrs/docs/adr/which-database-to-use","h":"#context-and-problem-statement","p":13},{"i":18,"t":"it has to be free it has to support json it has to be deployable locally","s":"Decision Drivers","u":"/cqrs/docs/adr/which-database-to-use","h":"#decision-drivers","p":13},{"i":20,"t":"mongodb supabase postgres","s":"Considered Options","u":"/cqrs/docs/adr/which-database-to-use","h":"#considered-options","p":13},{"i":22,"t":"Chosen option: supabase, because Xan told me about this and it's a BaaS (Backend-as-a-Service) and I could delete the entire existing backend. It's fronted by an api-gateway with a REST-API and the existing backend is a REST-api to talk to a mongodb.","s":"Decision Outcome","u":"/cqrs/docs/adr/which-database-to-use","h":"#decision-outcome","p":13},{"i":24,"t":"no need for a custom backend","s":"Positive Consequences","u":"/cqrs/docs/adr/which-database-to-use","h":"#positive-consequences","p":13},{"i":26,"t":"backend contains some validation, but I'll think about this later","s":"Negative Consequences","u":"/cqrs/docs/adr/which-database-to-use","h":"#negative-consequences","p":13},{"i":28,"t":"Status: accepted Date: 2025-12-22 Tags: adr,documentation,log4brains","s":"Which tool to use for ADR decisions","u":"/cqrs/docs/adr/which-tool-to-use-for-adr-decisions","h":"","p":27},{"i":30,"t":"How to keep track of design decisions?","s":"Context and Problem Statement","u":"/cqrs/docs/adr/which-tool-to-use-for-adr-decisions","h":"#context-and-problem-statement","p":27},{"i":32,"t":"should be close to the code should be searchable should also have a human-readable version","s":"Decision Drivers","u":"/cqrs/docs/adr/which-tool-to-use-for-adr-decisions","h":"#decision-drivers","p":27},{"i":34,"t":"Log4brains: architecture knowledge base (command-line + static site generator) ADR Tools: command-line to create ADRs ADR Tools Python: command-line to create ADRs adr-viewer: static site generator adr-log: command-line to create a TOC of ADRs","s":"Considered Options","u":"/cqrs/docs/adr/which-tool-to-use-for-adr-decisions","h":"#considered-options","p":27},{"i":36,"t":"Chosen option: log4brains, because it is close to the code, searchable, supports multiple projects and has a human-readable form.","s":"Decision Outcome","u":"/cqrs/docs/adr/which-tool-to-use-for-adr-decisions","h":"#decision-outcome","p":27},{"i":38,"t":"The backend was not made at all. We are using Supabase which is a Backend as a Service. We have a free Supabase account which contains a postgres database to save the conversations. Supabase also has an API-gateway to query this data using REST calls.","s":"How is the backend made?","u":"/cqrs/docs/how/how-backend","h":"","p":37},{"i":40,"t":"The front-end is made with React, Vite and Typescript. Most of it was made with the use of AI, hence the bugs.","s":"How is the frontend made?","u":"/cqrs/docs/how/how-frontend","h":"","p":39},{"i":42,"t":"The application is hosted on Render. We have a free account on render that points to a github repo and contains a run command and some Supabase environment variables. Here is a diagram, because diagrams are cool. Click here to see a diagram","s":"How is the application hosted?","u":"/cqrs/docs/how/how-hosting","h":"","p":41},{"i":44,"t":"Zod is used for validation both in the frontend and the backend. Zod lets you define schemas describing what valid data looks like, then validate runtime data against those schemas. The schema looks like this: import { z } from \"zod\"; const participantSchema = z.object({ name: z.string().nonempty(\"participant name is required\"), victim: z.boolean().optional(), }); const lineSchema = z.object({ text: z.string().nonempty(\"line text is required\"), lineType: z.enum([\"CONTEXT\", \"SPEECH\"]), punchLine: z.boolean().optional(), participants: z.array(participantSchema).min(1, \"line must have at least one participant\") }); const conversationSchema = z.object({ id: z.uuid(), lines: z.array(lineSchema), createdOn: z.string(), conversationDate: z.string().nonempty(\"conversationDate is required\") }); export default conversationSchema; You can use this schema to validate the data and capture the errrors: ```ts const result = conversationSchema.safeParse(conversationData); ## Frontend In the frontend this validation is done before submitting the new quote form. ## Backend In the backend the same validation is added to a [Supabase Edge Function](https://supabase.com/docs/guides/functions) that saves the new quote.","s":"How does validation work?","u":"/cqrs/docs/how/how-validation","h":"","p":43},{"i":46,"t":"Welcome to the CQRS documentation. This documentation was built using Docusaurus. Docusaurus let's you write md or mdx files. Mdx lets you use JSX in your markdown content. You can import components, such as interactive charts or alerts, and embed them within your content. Like this: Show Pop-up","s":"Hello","u":"/cqrs/docs/intro","h":"","p":45},{"i":48,"t":"This is the fault of AI and not of the developer.","s":"Why are there bugs in the UI?","u":"/cqrs/docs/why/why-are-there-bugs-in-ui","h":"","p":47},{"i":50,"t":"This is the consequence of an event known as 'The Great MongoDB Tragedy'. Long story short: We had an application with a MongoDB that we were using instead of notepad, but MongoDB did some changes and we did not react to e-mails saying: \"Warning, if you do not reply, your data will be lost\".","s":"Why are there missing years?","u":"/cqrs/docs/why/why-are-there-missing-years","h":"","p":49},{"i":52,"t":"The CQRS application exists because people say a lot of funny things all the time. Before the first version of this application existed, we used to save conversations in notepad files. But we are not cavemen anymore and we decided we needed an application to save the conversations. With this app you can save those conversations, with or without context.","s":"Why does the CQRS app exist?","u":"/cqrs/docs/why/why-cqrs-exists","h":"","p":51}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,2.515,1,1.753,2,2.511,3,2.515,4,2.515,5,2.205,6,2.929,7,2.515,8,1.958,9,2.205,10,1.577,11,1.753]],["t/4",[1,1.466,2,1.638,8,2.231,9,0.893,10,1.521,11,1.158,12,1.661,13,1.186,14,1.019,15,1.186,16,1.186,17,1.934,18,1.186,19,1.019,20,1.186,21,1.019,22,1.186,23,1.019,24,1.019,25,1.019,26,1.186,27,1.186,28,1.186,29,1.186,30,1.186,31,1.019,32,1.934,33,1.186,34,1.661,35,1.186,36,0.893,37,0.793,38,1.186,39,1.934,40,1.186,41,1.186,42,1.186,43,1.186,44,1.186,45,1.186,46,1.186,47,1.186,48,1.186,49,1.186,50,0.793,51,1.186,52,1.186,53,1.186,54,0.793,55,1.186,56,1.019,57,1.934,58,1.186,59,1.186,60,1.186,61,1.186,62,1.186,63,1.186,64,1.186,65,1.186,66,1.186,67,1.186,68,1.186,69,1.186]],["t/6",[10,1.144,37,1.421,50,1.421,54,1.421,70,2.126,71,2.126,72,2.126,73,2.126,74,2.126,75,2.126,76,2.126,77,2.126,78,2.126,79,1.825,80,2.126,81,2.126,82,1.825,83,1.601,84,2.126,85,2.126,86,1.601,87,2.126,88,2.126,89,1.825,90,1.601,91,2.126,92,0.933,93,2.126,94,2.126,95,2.126,96,2.126]],["t/8",[0,2.515,1,1.753,2,2.511,3,2.515,4,2.515,5,2.205,6,2.929,7,2.515,8,1.958,9,2.205,10,1.577,11,1.753]],["t/10",[1,1.466,2,1.638,8,2.231,9,0.893,10,1.521,11,1.158,12,1.661,13,1.186,14,1.019,15,1.186,16,1.186,17,1.934,18,1.186,19,1.019,20,1.186,21,1.019,22,1.186,23,1.019,24,1.019,25,1.019,26,1.186,27,1.186,28,1.186,29,1.186,30,1.18